# Lead capture. Without PUBLIC_FORM_ENDPOINT the apply form refuses to fake a
# success and shows the contact address instead — set both before any outreach.
#
# Any service that accepts a POST works: Formspree, Web3Forms, a Cloudflare
# Worker. Sign up, paste the endpoint here.
PUBLIC_FORM_ENDPOINT=
PUBLIC_CONTACT_EMAIL=

# Set by the GitHub Pages workflow; leave unset locally.
# SITE=
# BASE_PATH=
