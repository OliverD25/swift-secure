---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import { localePath, languages, getLanguage, defaultLocale } from "../i18n";
import { DEFAULT_THEME, STORAGE_KEY, THEMES } from "../lib/theme";
import "../styles/global.css";

interface Props {
  locale: string;
  /** Route without any locale prefix, e.g. "/" or "/about/". Used for hreflang. */
  path: string;
  title: string;
  description: string;
  current?: "process" | "methodology" | "pricing" | "about" | "faq" | "casinos" | "verify";
  /**
   * Keep the page out of the index while still following its links.
   *
   * Set on directory entries we have not checked. Each is a template filled
   * with register data, so across 19 locales they are thousands of near
   * identical pages — the pattern search engines treat as thin content, and
   * they can drag down the whole site rather than just themselves. A page
   * earns indexing once a real check has run on it.
   */
  noindex?: boolean;
}

const { locale, path, title, description, current, noindex = false } = Astro.props;
const lang = getLanguage(locale);

const abs = (p: string) => new URL(p, Astro.site).toString();
const canonicalURL = abs(localePath(path, locale));
const pageTitle = title === "Swift Secure" ? title : `${title} | Swift Secure`;

const showStickyCta = !path.startsWith("/apply");

// Runs before first paint so someone who picked a non-default option at
// /settings/ does not see a frame of the shipped default first. Inline and
// blocking on purpose — a deferred module lands after the page has painted.
const themeBootstrap = `(function(){try{var t=localStorage.getItem(${JSON.stringify(STORAGE_KEY)});if(${JSON.stringify(THEMES)}.indexOf(t)>-1){document.documentElement.dataset.theme=t}}catch(e){}})()`;
---

<!doctype html>
<html lang={lang.htmlLang} dir={lang.dir} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      /* Tell search engines this page exists in 19 languages, so the right one
         is surfaced per user rather than them competing as duplicates.
         Skipped when noindexed: hreflang nominates a page as the right result
         for a language, which contradicts asking for it not to be indexed. */
      !noindex &&
        languages.map((l) => <link rel="alternate" hreflang={l.htmlLang} href={abs(localePath(path, l.locale))} />)
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(localePath(path, defaultLocale))} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Swift Secure" />
    <meta property="og:locale" content={lang.htmlLang.replace("-", "_")} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={localePath("/favicon.svg", defaultLocale)} />
    <link rel="icon" href={localePath("/favicon.ico", defaultLocale)} sizes="32x32" />
    <meta name="theme-color" content="#0c0b12" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline set:html={themeBootstrap} />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink">
    <Header locale={locale} path={path} current={current} />
    <slot />
    <Footer locale={locale} />
    {showStickyCta && <StickyCta locale={locale} />}
  </body>
</html>
