---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import DesignSwitcher from "../components/DesignSwitcher.astro";
import { localePath, languages, getLanguage, defaultLocale } from "../i18n";
import { DEFAULT_THEME, STORAGE_KEY, THEMES } from "../lib/theme";
import "../styles/global.css";

interface Props {
  locale: string;
  /** Route without any locale prefix, e.g. "/" or "/about/". Used for hreflang. */
  path: string;
  title: string;
  description: string;
  current?: "process" | "pricing" | "about" | "faq" | "casinos" | "verify";
}

const { locale, path, title, description, current } = Astro.props;
const lang = getLanguage(locale);

const abs = (p: string) => new URL(p, Astro.site).toString();
const canonicalURL = abs(localePath(path, locale));
const pageTitle = title === "Swift Secure" ? title : `${title} | Swift Secure`;

const showStickyCta = !path.startsWith("/apply");

// Runs before first paint so a reviewer who picked Option C does not see a
// frame of Option A first. Inline and blocking on purpose — a deferred module
// would land after the page has already painted the built-in default.
const themeBootstrap = `(function(){try{var t=localStorage.getItem(${JSON.stringify(STORAGE_KEY)});if(${JSON.stringify(THEMES)}.indexOf(t)>-1){document.documentElement.dataset.theme=t}}catch(e){}})()`;
---

<!doctype html>
<html lang={lang.htmlLang} dir={lang.dir} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {
      /* Tell search engines this page exists in 19 languages, so the right one
         is surfaced per user rather than them competing as duplicates. */
      languages.map((l) => <link rel="alternate" hreflang={l.htmlLang} href={abs(localePath(path, l.locale))} />)
    }
    <link rel="alternate" hreflang="x-default" href={abs(localePath(path, defaultLocale))} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Swift Secure" />
    <meta property="og:locale" content={lang.htmlLang.replace("-", "_")} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={localePath("/favicon.svg", defaultLocale)} />
    <link rel="icon" href={localePath("/favicon.ico", defaultLocale)} sizes="32x32" />
    {/* Matches the review bar pinned at the top of the page, not the nav.
        Revisit when the switcher is removed. */}
    <meta name="theme-color" content="#101314" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline set:html={themeBootstrap} />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink">
    <DesignSwitcher />
    <Header locale={locale} path={path} current={current} />
    <slot />
    <Footer locale={locale} />
    {showStickyCta && <StickyCta locale={locale} />}
  </body>
</html>
