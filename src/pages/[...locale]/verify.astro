---
import Layout from "../../layouts/Layout.astro";
import { useTranslations, localeStaticPaths, localePath } from "../../i18n";
import { casinos } from "../../data/casinos";

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props;
const t = useTranslations(locale);

// A REAL lookup, against the real registry.
//
// This page used to fabricate a pass. Any ID ending in "42" returned "Valid &
// active seal" for "Northgate Interactive Ltd., Malta Gaming Authority,
// certified since Mar 2025" — an operator, a regulator and a date that do not
// exist, hardcoded into the markup. The one page whose entire purpose is to
// prove a badge is genuine was manufacturing a positive result for arbitrary
// input, which is worse than having no verify page at all.
//
// Built from the directory at build time. A seal is only ever real when an
// operator has one, so today this list is empty and every lookup correctly
// returns "not found". When the first badge is issued the entry gains a sealId
// and this starts answering without any further change here.
const seals = casinos
  .filter((c) => c.sealId && c.status === "certified")
  .map((c) => ({
    id: c.sealId!.toUpperCase(),
    operator: c.operator ?? c.name,
    jurisdiction: c.jurisdiction,
    lastChecked: c.lastScanned,
  }));
---

<Layout locale={locale} path="/verify/" title={t.verify.title} description={t.verify.description} current="verify">
  <main>
    <section class="mx-auto w-full max-w-[640px] px-6 py-18">
      <div class="mb-9 text-center">
        <h1 class="text-h2 mb-3">{t.verify.h1}</h1>
        <p class="text-base text-muted">{t.verify.sub}</p>
      </div>

      <div class="mb-7 flex gap-2.5">
        <input
          type="text"
          data-verify-input
          placeholder={t.verify.inputPlaceholder}
          aria-label={t.verify.inputLabel}
          class="flex-1 rounded-btn border border-btn-line bg-surface px-4 py-3.5 text-[15px] font-sans text-ink placeholder:text-faint"
        />
        <button type="button" data-verify-btn class="btn-primary px-6 py-3.5 text-[15px] font-semibold">
          {t.verify.button}
        </button>
      </div>

      <div data-verify-result hidden aria-live="polite">
        <div data-verify-valid hidden class="rounded-card border border-accent/40 bg-accent-soft p-6.5">
          <div class="mb-4 flex items-center gap-2.5">
            <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-accent text-[15px] font-bold text-[var(--logo-ink)]">&#10003;</div>
            <div class="text-[17px] font-bold text-accent-soft-text">{t.verify.validStatus}</div>
          </div>
          <div class="flex flex-col gap-2 text-sm text-ink">
            <div><strong>{t.verify.operator}</strong> <span data-seal-operator></span></div>
            <div><strong>{t.verify.jurisdiction}</strong> <span data-seal-jurisdiction></span></div>
            <div><strong>{t.verify.lastChecked}</strong> <span data-seal-checked></span></div>
          </div>
        </div>
        <div data-verify-invalid hidden class="rounded-card border border-warn-line bg-warn-soft p-6.5">
          <div class="mb-4 flex items-center gap-2.5">
            <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-warn text-[15px] font-bold text-canvas">!</div>
            <div class="text-[17px] font-bold text-warn-soft-text">{t.verify.invalidStatus}</div>
          </div>
          <div class="text-sm text-muted">
            {t.verify.invalidBody} <a href={localePath("/apply/", locale)}>{t.verify.contactUs}</a>.
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ seals }}>
  const input = document.querySelector("[data-verify-input]");
  const button = document.querySelector("[data-verify-btn]");
  const result = document.querySelector("[data-verify-result]");
  const valid = document.querySelector("[data-verify-valid]");
  const invalid = document.querySelector("[data-verify-invalid]");

  const runVerify = () => {
    if (!input || !result || !valid || !invalid) return;
    const id = input.value.trim().toUpperCase();
    if (!id) {
      result.hidden = true;
      return;
    }
    // Exact match against issued seals only. No suffix matching, no fallback:
    // an ID we did not issue has to fail, including one that merely resembles
    // a real one.
    const seal = seals.find((s) => s.id === id);
    if (seal) {
      valid.querySelector("[data-seal-operator]").textContent = seal.operator;
      valid.querySelector("[data-seal-jurisdiction]").textContent = seal.jurisdiction;
      valid.querySelector("[data-seal-checked]").textContent = seal.lastChecked;
    }
    valid.hidden = !seal;
    invalid.hidden = Boolean(seal);
    result.hidden = false;
  };

  button?.addEventListener("click", runVerify);
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") runVerify();
  });
</script>
