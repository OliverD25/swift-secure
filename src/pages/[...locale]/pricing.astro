---
import Layout from "../../layouts/Layout.astro";
import { useTranslations, localeStaticPaths, localePath } from "../../i18n";

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} path="/pricing/" title={t.pricing.title} description={t.pricing.description} current="pricing">
  <main>
    <section class="mx-auto w-full max-w-[700px] px-[clamp(20px,5vw,40px)] pb-10 pt-18 text-center">
      <div class="eyebrow mb-2.5 text-[13px] font-bold">{t.pricing.eyebrow}</div>
      <h1 class="text-h2 mb-4">{t.pricing.h1}</h1>
      <p class="text-lg leading-relaxed text-muted">{t.pricing.sub}</p>
    </section>




    <!-- BILLING -->
    <section class="mx-auto w-full max-w-[900px] px-[clamp(20px,5vw,40px)] pb-22.5 pt-15">
      <h2 class="text-h2 mb-8 text-center">{t.pricing.billingTitle}</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-5">
        {
          t.billingNotes.map((b) => (
            <div class="card p-5">
              <div class="mb-1.5 text-[15px] font-bold">{b.title}</div>
              <div class="text-sm leading-relaxed text-muted">{b.desc}</div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
