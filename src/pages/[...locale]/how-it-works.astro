---
import Layout from "../../layouts/Layout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { useTranslations, localeStaticPaths } from "../../i18n";

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} path="/how-it-works/" title={t.process.title} description={t.process.description} current="process">
  <main>
    <section class="mx-auto w-full max-w-[900px] px-[clamp(20px,5vw,40px)] pb-10 pt-18 text-center">
      <div class="eyebrow mb-2.5 text-[13px] font-bold">{t.process.eyebrow}</div>
      <h1 class="text-h2 mb-4">{t.process.h1}</h1>
      <p class="text-lg leading-relaxed text-muted">{t.process.sub}</p>
    </section>

    <section class="mx-auto w-full max-w-[800px] px-[clamp(20px,5vw,40px)] pb-22.5 pt-10">
      {
        t.stages.map((stage, i) => (
          <div class="relative flex gap-6 pb-10">
            <div class="flex flex-col items-center">
              <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-band text-[15px] font-extrabold text-band-text">
                {stage.n}
              </div>
              {i < t.stages.length - 1 && <div class="mt-1 w-0.5 flex-1 bg-line" />}
            </div>
            <div class="card -mt-0.5 flex-1 p-6.5">
              <div class="mb-2 flex flex-wrap items-center justify-between gap-3">
                <div class="text-lg font-bold">{stage.title}</div>
                <div class="chip whitespace-nowrap px-2.5 py-1 text-xs font-semibold">
                  {stage.duration}
                </div>
              </div>
              <div class="mb-3 text-sm leading-relaxed text-muted">{stage.desc}</div>
              <div class="text-[13px] text-muted">
                <strong>{t.common.youProvide}</strong> {stage.provide}
              </div>
            </div>
          </div>
        ))
      }
    </section>

    <CtaBand locale={locale} heading={t.process.ctaHeading} ctaLabel={t.process.ctaButton} ctaHref="/apply/" />
  </main>
</Layout>
