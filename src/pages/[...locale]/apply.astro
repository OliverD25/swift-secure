---
import Layout from "../../layouts/Layout.astro";
import { useTranslations, localeStaticPaths } from "../../i18n";
import { FORM_ENDPOINT, CONTACT_EMAIL } from "../../lib/leadCapture";

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props;
const t = useTranslations(locale);

const [successBefore, successAfter] = t.apply.successBody.split("{email}");
const fieldClass =
  "rounded-btn border border-btn-line bg-surface px-3.5 py-3 text-sm font-sans text-ink placeholder:text-faint";
const labelClass = "text-[13px] font-semibold text-muted";
---

<Layout locale={locale} path="/apply/" title={t.apply.title} description={t.apply.description}>
  <main>
    <section class="mx-auto w-full max-w-[640px] px-6 py-16">
      <div class="mb-9">
        <div class="eyebrow mb-2.5 text-[13px] font-bold">{t.apply.eyebrow}</div>
        <h1 class="text-h2 mb-2.5">{t.apply.h1}</h1>
        <p class="text-[15px] text-muted">{t.apply.sub}</p>
      </div>

      <form
        data-apply-form
        data-endpoint={FORM_ENDPOINT}
        data-contact={CONTACT_EMAIL}
        class="flex flex-col gap-4.5"
        novalidate
      >
        <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="name" class={labelClass}>{t.apply.fieldName}</label>
            <input id="name" name="name" type="text" required placeholder={t.apply.fieldNamePlaceholder} class={fieldClass} />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="website" class={labelClass}>{t.apply.fieldWebsite}</label>
            <input id="website" name="website" type="url" required placeholder="https://" class={fieldClass} />
          </div>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="jurisdiction" class={labelClass}>{t.apply.fieldJurisdiction}</label>
            <input
              id="jurisdiction"
              name="jurisdiction"
              type="text"
              required
              placeholder={t.apply.fieldJurisdictionPlaceholder}
              class={fieldClass}
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="email" class={labelClass}>{t.apply.fieldEmail}</label>
            <input id="email" name="email" type="email" required placeholder="you@company.com" class={fieldClass} />
          </div>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="message" class={labelClass}>{t.apply.fieldMessage}</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder={t.apply.fieldMessagePlaceholder}
            class={`resize-y ${fieldClass}`}></textarea>
        </div>
        <button type="submit" class="btn-primary mt-1.5 py-4 text-[15px] font-semibold">{t.apply.submit}</button>
      </form>

      <div data-apply-success hidden class="rounded-card border border-accent/40 bg-accent-soft px-6 py-12 text-center">
        <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-accent text-[22px] font-bold text-[var(--logo-ink)]">&#10003;</div>
        <div class="mb-2 text-[19px] font-bold">{t.apply.successTitle}</div>
        <div class="text-sm text-accent-soft-text">
          {successBefore}<span data-apply-email></span>{successAfter}
        </div>
      </div>

      {/* Shown when the submission could not be delivered. A visible failure
          with a working address beats a success screen that loses the lead. */}
      <div data-apply-error hidden class="mt-6 rounded-card border border-warn-line bg-warn-soft p-5.5">
        <div class="mb-1.5 text-[15px] font-bold text-warn-soft-text">We could not submit that automatically</div>
        <p class="text-sm leading-relaxed text-muted">
          Nothing was lost on your side, but the form did not reach us. Please email the details straight to
          {" "}
          {CONTACT_EMAIL ? (
            <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-accent">
              {CONTACT_EMAIL}
            </a>
          ) : (
            <span class="font-semibold">our team</span>
          )}
          {" "}and we will pick it up from there.
        </p>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-apply-form]");
  const success = document.querySelector<HTMLElement>("[data-apply-success]");
  const failure = document.querySelector<HTMLElement>("[data-apply-error]");
  const emailSpan = document.querySelector<HTMLElement>("[data-apply-email]");

  const showSuccess = (email: string) => {
    if (emailSpan && email) emailSpan.textContent = email;
    if (form) form.hidden = true;
    if (success) success.hidden = false;
  };

  // Never hide the form on failure: the operator keeps what they typed and can
  // copy it into an email rather than retyping everything.
  const showFailure = () => {
    if (failure) failure.hidden = false;
    failure?.scrollIntoView({ behavior: "smooth", block: "center" });
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const endpoint = form.dataset.endpoint ?? "";
    const email = (form.querySelector<HTMLInputElement>("#email")?.value ?? "").trim();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const original = button?.textContent ?? "";

    if (!endpoint) {
      // Not configured. Saying so is the only honest option — the previous
      // behaviour was to show success and discard the application.
      showFailure();
      return;
    }

    if (button) {
      button.disabled = true;
      button.textContent = "…";
    }
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      showSuccess(email);
    } catch {
      showFailure();
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = original;
      }
    }
  });
</script>
