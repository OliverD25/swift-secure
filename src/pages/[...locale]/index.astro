---
import Layout from "../../layouts/Layout.astro";
import Seal from "../../components/Seal.astro";
import CasinoCheck from "../../components/CasinoCheck.astro";
import StatRow from "../../components/StatRow.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CasinoCard from "../../components/CasinoCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { featuredCasinos } from "../../data/casinos";
import { useTranslations, localeStaticPaths, localePath } from "../../i18n";

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props;
const t = useTranslations(locale);

const siteUrl = Astro.site?.toString() ?? "/";
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Swift Secured",
  url: siteUrl,
  logo: new URL("favicon.svg", siteUrl).toString(),
  description: t.home.description,
};
---

<Layout locale={locale} path="/" title={t.home.title} description={t.home.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <main>
    {/* HERO. Centred on one column rather than the earlier text-beside-seal
        split, so the lookup is the first thing on the page: a visitor who
        arrived holding a casino name can act on it without scrolling or
        choosing a menu item. Order matches what the owner asked for on
        13 August 2026 — headline, subline, search, steps, footnote. */}
    <section class="mx-auto w-full max-w-[1280px] px-[clamp(20px,5vw,40px)] py-16 text-center">
      <div class="mb-7 flex justify-center">
        <div
          class="flex size-[168px] items-center justify-center rounded-full"
          style="background: var(--hero-disc); box-shadow: var(--hero-disc-shadow);"
        >
          <Seal locale={locale} variant="primary" size={116} />
        </div>
      </div>
      <div class="chip mb-5 inline-flex items-center gap-2 px-3 py-1.5 text-[13px] font-semibold">
        <span class="size-1.5 rounded-full bg-accent"></span>
        {t.home.badge}
      </div>
      <h1 class="text-hero mx-auto mb-5 max-w-[900px]">{t.home.h1}</h1>
      <p class="mx-auto mb-9 max-w-[640px] text-lg leading-relaxed text-muted sm:text-[19px]">{t.home.sub}</p>

      <CasinoCheck locale={locale} />

      {/* Both destinations are also in the header, but they were the hero's
          only actions before the lookup existed and nothing is gained by
          dropping them. They sit below the search, not beside it. */}
      <div class="mt-9 flex flex-wrap justify-center gap-3.5">
        <a href={localePath("/apply/", locale)} class="btn-primary px-6.5 py-3.5 text-base font-semibold">
          {t.home.ctaApply}
        </a>
        <a
          href={localePath("/verify/", locale)}
          class="btn-secondary px-6.5 py-3.5 text-base font-semibold"
        >
          {t.home.ctaVerify} &rarr;
        </a>
      </div>
    </section>

    <!-- STATS -->
    <section class="bg-band px-[clamp(20px,5vw,40px)] py-9">
      <div class="mx-auto max-w-[1280px]">
        <StatRow locale={locale} variant="dark" />
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="mx-auto w-full max-w-[1280px] px-[clamp(20px,5vw,40px)] py-22.5">
      <SectionHeading eyebrow={t.home.howEyebrow} title={t.home.howTitle} />
      <div class="grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-7">
        {
          t.steps.map((step) => (
            <div class="card p-7">
              <div class="chip mb-4 flex size-9 items-center justify-center text-[15px] font-extrabold">
                {step.n}
              </div>
              <div class="mb-2 text-[17px] font-bold">{step.title}</div>
              <div class="text-sm leading-relaxed text-muted">{step.desc}</div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CRITERIA -->
    <section id="criteria" class="bg-surface-2 px-[clamp(20px,5vw,40px)] py-22.5">
      <div class="mx-auto max-w-[1280px]">
        <SectionHeading eyebrow={t.home.criteriaEyebrow} title={t.home.criteriaTitle} />
        <div class="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-6">
          {
            t.criteria.map((c) => (
              <div class="card p-6.5">
                <div class="mb-2 flex items-center gap-2 text-base font-bold">
                  <span class="size-2 shrink-0 rounded-full bg-accent" />
                  {c.title}
                </div>
                <div class="text-sm leading-relaxed text-muted">{c.desc}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* The index. Nothing here is "certified" — no badge has been issued, and
        an HTML comment saying otherwise still ships to the reader. */}
    <section class="mx-auto w-full max-w-[1280px] px-[clamp(20px,5vw,40px)] py-22.5">
      <div class="mb-11 flex flex-wrap items-end justify-between gap-6">
        <div>
          <div class="eyebrow mb-2.5 text-[13px] font-bold">{t.home.operatorsEyebrow}</div>
          <h2 class="text-h2">{t.home.operatorsTitle}</h2>
        </div>
        <a href={localePath("/casinos/", locale)} class="whitespace-nowrap text-[15px] font-semibold text-accent">{t.home.viewAllCasinos} &rarr;</a>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-5.5">
        {featuredCasinos().map((casino) => <CasinoCard locale={locale} casino={casino} href="/casinos/" />)}
      </div>
    </section>



    {/* The button reads "What we do not check", so it goes to the page that
        lists the limits — not to the operator sign-up form it pointed at while
        this band was still addressed to casinos. */}
    <CtaBand
      locale={locale}
      heading={t.home.ctaHeading}
      subtext={t.home.ctaSub}
      ctaLabel={t.home.ctaButton}
      ctaHref="/methodology/"
    />
  </main>
</Layout>
