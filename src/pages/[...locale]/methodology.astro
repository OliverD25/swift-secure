---
import Layout from "../../layouts/Layout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { useTranslations, localeStaticPaths } from "../../i18n";

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} path="/methodology/" title={t.methodology.title} description={t.methodology.description} current="methodology">
  <main>
    <section class="mx-auto w-full max-w-[820px] px-[clamp(20px,5vw,40px)] pb-8 pt-18 text-center">
      <div class="eyebrow mb-2.5 text-[13px] font-bold">{t.methodology.eyebrow}</div>
      <h1 class="text-h2 mb-4">{t.methodology.h1}</h1>
      <p class="text-lg leading-relaxed text-muted">{t.methodology.sub}</p>
    </section>

    <!-- WHAT WE CHECK -->
    <section class="mx-auto w-full max-w-[900px] px-[clamp(20px,5vw,40px)] py-10">
      <h2 class="text-h2 mb-7">{t.methodology.checksTitle}</h2>
      <div class="flex flex-col gap-5">
        {
          t.tiers.map((tier) => (
            <div class="card p-6.5">
              <div class="mb-2 flex flex-wrap items-center gap-3">
                <span class="chip px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide">{tier.id}</span>
                <span class="text-[15px] font-semibold">{tier.summary}</span>
              </div>
              <ul class="mt-3 flex flex-col gap-2">
                {tier.checks.map((c) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                    <span class="mt-0.5 shrink-0 text-accent">&#10003;</span>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- WHAT WE DON'T CHECK — deliberately as prominent as the claims above. -->
    <section class="bg-surface-2 px-[clamp(20px,5vw,40px)] py-15">
      <div class="mx-auto max-w-[900px]">
        <h2 class="text-h2 mb-2">{t.methodology.limitsTitle}</h2>
        <p class="mb-7 max-w-[640px] text-sm leading-relaxed text-muted">{t.methodology.limitsSub}</p>
        <div class="flex flex-col gap-4">
          {
            t.limits.map((l) => (
              <div class="rounded-card border border-warn-line bg-warn-soft p-5.5">
                <div class="mb-1.5 flex gap-2.5 text-[15px] font-bold text-warn-soft-text">
                  <span aria-hidden="true">&#10005;</span>
                  {l.title}
                </div>
                <div class="ps-6 text-sm leading-relaxed text-muted">{l.desc}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- MONITORING + SUSPENSION -->
    <section class="mx-auto grid w-full max-w-[900px] grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-6 px-[clamp(20px,5vw,40px)] py-15">
      <div class="card p-6.5">
        <div class="mb-2.5 text-lg font-bold">{t.methodology.monitoringTitle}</div>
        <div class="text-sm leading-relaxed text-muted">{t.methodology.monitoringBody}</div>
      </div>
      <div class="card p-6.5">
        <div class="mb-2.5 text-lg font-bold">{t.methodology.suspensionTitle}</div>
        <div class="text-sm leading-relaxed text-muted">{t.methodology.suspensionBody}</div>
      </div>
    </section>

    <CtaBand locale={locale} heading={t.methodology.ctaHeading} ctaLabel={t.methodology.ctaButton} ctaHref="/apply/" />
  </main>
</Layout>
