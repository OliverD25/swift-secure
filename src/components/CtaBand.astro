---
import { localePath } from "../i18n";

interface Props {
  locale: string;
  heading: string;
  subtext?: string;
  ctaLabel: string;
  ctaHref: string;
  size?: "lg" | "md";
}

const { locale, heading, subtext, ctaLabel, ctaHref, size = "md" } = Astro.props;
---

<section data-cta-band class:list={["bg-band px-5 text-center sm:px-[clamp(20px,5vw,40px)]", size === "lg" ? "py-18" : "py-15"]}>
  <h2 class:list={["mx-auto mb-3.5 max-w-2xl text-band-text", size === "lg" ? "text-h2" : "text-[28px]"]}>
    {heading}
  </h2>
  {subtext && <p class="mb-7 text-base text-band-muted">{subtext}</p>}
  <a
    href={localePath(ctaHref, locale)}
    class:list={["btn-on-band inline-block font-bold", size === "lg" ? "px-7.5 py-3.5 text-base" : "px-6.5 py-3.5 text-[15px]"]}
  >
    {ctaLabel}
  </a>
</section>
