---
import { useTranslations } from "../i18n";
import { casinos, statusCount } from "../data/casinos";
import type { StatCount } from "../i18n/types";

interface Props {
  locale: string;
  variant?: "dark" | "light";
}

const { locale, variant = "dark" } = Astro.props;
const t = useTranslations(locale);

// Every number on this row is counted out of the index while the site builds,
// because the translation file is the wrong place to keep a fact. The four
// figures that stood here first were invented, and their honest replacements
// still went stale the moment a casino was added.
const byJurisdiction = new Map<string, number>();
for (const casino of casinos) {
  byJurisdiction.set(casino.jurisdiction, (byJurisdiction.get(casino.jurisdiction) ?? 0) + 1);
}
const ranked = [...byJurisdiction.entries()].sort((a, b) => b[1] - a[1]);
const topRegulator = ranked[0]?.[0] ?? "—";

const figures: Record<StatCount, number> = {
  listed: casinos.length,
  topJurisdiction: ranked[0]?.[1] ?? 0,
  badged: statusCount("certified"),
};

// A tile counting zero is hidden rather than shown as "0".
//
// "Displaying verified seal today: 0" was on the home page, in twenty
// languages, telling every visitor that nobody uses the product. The figure was
// true, which is why nothing here flagged it — but a home page is not obliged
// to publish a zero, and this one was doing active harm.
//
// Hiding is the whole fix, and it is deliberately here rather than in the copy.
// Every locale defines its own three-entry `stats` array, and arrays are
// replaced whole rather than merged per item, so removing the tile from en.ts
// would have left the zero standing in the other nineteen languages. One filter
// in the component fixes all twenty at once.
//
// It also reverses itself. The day the first badge is issued the count stops
// being zero and the tile returns, in every language, with the label each one
// already has. Nothing needs remembering.
const visible = t.stats.filter((s) => figures[s.count] > 0);
---

<div class="grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-6 text-center">
  {
    visible.map((s) => (
      <div>
        <div class:list={["text-[32px] font-extrabold", variant === "dark" ? "text-band-text" : "text-accent"]}>
          {figures[s.count].toLocaleString("en-US")}
        </div>
        <div class:list={["mt-1 text-sm", variant === "dark" ? "text-band-muted" : "text-muted"]}>
          {s.label.replace("{regulator}", topRegulator)}
        </div>
      </div>
    ))
  }
</div>
