---
import { useTranslations } from "../i18n";

interface Props {
  locale: string;
  variant?: "dark" | "light";
}

const { locale, variant = "dark" } = Astro.props;
const t = useTranslations(locale);
---

<div class="grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-6 text-center">
  {
    t.stats.map((s) => (
      <div>
        <div class:list={["text-[32px] font-extrabold", variant === "dark" ? "text-band-text" : "text-accent"]}>{s.value}</div>
        <div class:list={["mt-1 text-sm", variant === "dark" ? "text-band-muted" : "text-muted"]}>{s.label}</div>
      </div>
    ))
  }
</div>
