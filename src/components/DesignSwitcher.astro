---
/**
 * Review device for choosing between the four design options.
 *
 * The chrome here is deliberately fixed — its own dark palette, always Inter,
 * never reading from the theme tokens. It has to read as review furniture, not
 * as part of the design being judged, and a bar that restyled itself per option
 * would muddy exactly the comparison it exists to support.
 *
 * Not translated: the audience is one reviewer, and localising the scaffolding
 * would imply it ships.
 *
 * To remove after a decision: delete this component and its two call sites in
 * Layout.astro, then drop `pt-[var(--switcher-h)]` from the header offset.
 */
export const options = [
  { id: "a", name: "Corporate Trust", note: "The current build — light, navy bands, emerald accent." },
  { id: "b", name: "Dark Casino", note: "Near-black and neon, square corners, uppercase headings." },
  { id: "c", name: "Premium Gold", note: "Serif headlines, gold on near-black, zero radius." },
  { id: "d", name: "Catalog", note: "Light canvas, dark floating nav, soft cards, gradient buttons." },
];
---

<div
  data-design-switcher
  class="sticky top-0 z-60 border-b border-[#262c2c] bg-[#101314] font-[Inter_Variable,Inter,system-ui,sans-serif]"
>
  <div class="flex items-center gap-3 overflow-x-auto px-4 py-2 no-scrollbar sm:px-5">
    <span class="hidden shrink-0 text-[11px] font-bold tracking-[0.16em] text-[#8b9694] sm:inline">DESIGN OPTIONS</span>

    <div class="flex shrink-0 items-center gap-1.5">
      {
        options.map((option) => (
          <button
            type="button"
            data-design-option={option.id}
            data-note={option.note}
            aria-pressed="false"
            class="flex shrink-0 items-center gap-1.5 rounded-[4px] border border-[#3a4241] px-2 py-1 text-[12px] font-medium text-[#c3ccca] transition-colors hover:border-[#55605e]"
          >
            <span class="text-[11px] font-bold uppercase opacity-70">{option.id}</span>
            <span class="whitespace-nowrap">{option.name}</span>
          </button>
        ))
      }
    </div>

    <span data-design-note class="ms-auto hidden shrink-0 ps-3 text-[11px] text-[#8b9694] lg:inline"></span>
  </div>
</div>

<script>
  import { applyTheme, readTheme, STORAGE_KEY } from "../lib/theme";

  const bar = document.querySelector<HTMLElement>("[data-design-switcher]");
  const noteEl = document.querySelector<HTMLElement>("[data-design-note]");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-design-option]")];

  // Publishes the bar's real height so the sticky header can offset by it. The
  // height is font-dependent, so measuring beats hardcoding 41px and drifting.
  const publishHeight = () => {
    if (bar) document.documentElement.style.setProperty("--switcher-h", `${bar.offsetHeight}px`);
  };

  const paint = (id: string) => {
    for (const button of buttons) {
      const active = button.dataset.designOption === id;
      button.setAttribute("aria-pressed", String(active));
      button.classList.toggle("bg-[#f4f6f5]", active);
      button.classList.toggle("text-[#101314]", active);
      button.classList.toggle("border-[#f4f6f5]", active);
      button.classList.toggle("text-[#c3ccca]", !active);
      button.classList.toggle("border-[#3a4241]", !active);
      if (active && noteEl) noteEl.textContent = button.dataset.note ?? "";
    }
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const id = button.dataset.designOption!;
      applyTheme(id);
      try {
        localStorage.setItem(STORAGE_KEY, id);
      } catch {
        /* private mode — the choice just won't persist */
      }
      paint(id);
    });
  }

  paint(readTheme());
  publishHeight();
  window.addEventListener("resize", publishHeight, { passive: true });
</script>
