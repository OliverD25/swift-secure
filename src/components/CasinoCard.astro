---
import type { Casino } from "../data/casinos";
import { useTranslations, localePath } from "../i18n";

interface Props {
  locale: string;
  casino: Casino;
  href?: string;
}

const { locale, casino, href } = Astro.props;
const t = useTranslations(locale);

// The status chip is the honest part of this card. A scanned casino gets a
// neutral chip and no tick — nothing here may imply an endorsement that was
// not earned, because the directory lists operators we have no relationship
// with alongside ones we verified.
const status = t.directory[casino.status];
const chipClass =
  casino.status === "certified"
    ? "chip"
    : casino.status === "flagged"
      ? "bg-warn-soft text-warn-soft-text rounded-pill"
      : "bg-surface-2 text-muted rounded-pill";
---

<div class="card flex h-full flex-col p-5.5">
  <div class="mb-3.5 flex items-start gap-3">
    <div
      class="flex size-11 shrink-0 items-center justify-center rounded-chip font-mono text-[9px] text-faint"
      style="background: repeating-linear-gradient(135deg, var(--surface-2), var(--surface-2) 4px, var(--border) 4px, var(--border) 8px);"
      aria-hidden="true"
    >
      logo
    </div>
    <div class="min-w-0">
      <div class="truncate text-[15px] font-bold">{casino.name}</div>
      <div class="truncate text-xs text-faint">{casino.jurisdiction}</div>
    </div>
  </div>

  <div class="mb-3 flex flex-wrap items-center gap-1.5">
    <span class:list={["inline-flex items-center gap-1.5 px-2.5 py-1 text-[12px] font-semibold", chipClass]}>
      {
        casino.status === "certified" && (
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8.5 12L11 14.5L16 9" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        )
      }
      {status.label}
      {casino.status === "certified" && casino.level && <span class="opacity-70">· {casino.level}</span>}
    </span>
  </div>

  <div class="mb-3 text-[12px] text-faint">
    {t.directory.lastScanned}: {casino.lastScanned}
  </div>

  {
    href && (
      <a
        href={localePath(`${href}${casino.slug}/`, locale)}
        class="btn-secondary mt-auto block py-2.5 text-center text-[13px] font-semibold"
      >
        {t.directory.viewReport} &rarr;
      </a>
    )
  }
</div>
