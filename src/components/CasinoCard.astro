---
import type { Casino } from "../data/casinos";
import { useTranslations, localePath } from "../i18n";

interface Props {
  locale: string;
  casino: Casino;
  href?: string;
}

const { locale, casino, href } = Astro.props;
const t = useTranslations(locale);
---

<div class="card p-5.5">
  <div class="mb-3.5 flex items-center gap-3">
    <div
      class="flex size-11 shrink-0 items-center justify-center rounded-[10px] font-mono text-[9px] text-faint"
      style="background: repeating-linear-gradient(135deg, var(--surface-2), var(--surface-2) 4px, var(--border) 4px, var(--border) 8px);"
      aria-hidden="true"
    >
      logo
    </div>
    <div>
      <div class="text-[15px] font-bold">{casino.name}</div>
      <div class="text-xs text-faint">{casino.jurisdiction}</div>
    </div>
  </div>
  <div class:list={["flex items-center gap-1.5", href && "mb-3"]}>
    <div class="flex size-4 shrink-0 items-center justify-center rounded-full bg-accent">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M8.5 12L11 14.5L16 9" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
    <span class="text-[12.5px] font-semibold text-accent-soft-text">{t.common.certifiedSince} {casino.since}</span>
  </div>
  {
    href && (
      <a
        href={localePath(href, locale)}
        class="btn-secondary block py-2.5 text-center text-[13px] font-semibold"
      >
        {t.common.viewSealRecord} &rarr;
      </a>
    )
  }
</div>
