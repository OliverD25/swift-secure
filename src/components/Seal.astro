---
import ChipMark from "./ChipMark.astro";
import { useTranslations } from "../i18n";

interface Props {
  locale: string;
  variant?: "primary" | "compact" | "dark";
  size?: number;
  class?: string;
}

const { locale, variant = "primary", size, class: className = "" } = Astro.props;
const t = useTranslations(locale);

const isDark = variant === "dark";
const diameter = size ?? (isDark ? 160 : 200);

// The badge is a chip ring with the wordmark stacked on top as real HTML rather
// than SVG <text>, so it stays translatable and reflows per locale. Type is
// expressed as a fraction of the diameter so the lockup holds at any size.
const frac = (atDesignSize: number, designDiameter: number) => (atDesignSize / designDiameter) * diameter;

const checkPx = isDark ? frac(24, 160) : frac(34, 200);
const titlePx = isDark ? frac(11, 160) : frac(14, 200);
const subBasePx = isDark ? frac(8, 160) : frac(9, 200);

// "CERTIFIED" is 9 characters; several localisations run far longer
// ("СЕРТИФИЦИРОВАНО" is 15) and would cross the inner ring at the design size.
// Estimating the rendered width from character count lets the sub-line step
// down just enough to stay inside, instead of clipping or overlapping the rim.
const SUB_ADVANCE = 0.86; // measured average advance per char, including the 0.14em tracking
const usableWidth = 0.51 * diameter; // chord available inside the inner ring at the sub-line's offset
const estimatedWidth = t.seal.certified.length * SUB_ADVANCE * subBasePx;
const subPx = Math.min(subBasePx, (usableWidth / estimatedWidth) * subBasePx);
---

{
  variant === "compact" ? (
    <div
      class:list={[
        "inline-flex items-center gap-2.5 rounded-full border-[1.5px] border-[oklch(85%_0.02_155)] bg-white px-4.5 py-2.5",
        className,
      ]}
    >
      <ChipMark size={28} kind="mark" />
      <span class="text-sm font-bold text-[oklch(25%_0.05_250)]">Swift Secure</span>
      <span class="text-xs font-semibold text-ink-muted">{t.seal.certified}</span>
    </div>
  ) : (
    <div class:list={["relative shrink-0", className]} style={{ width: `${diameter}px`, height: `${diameter}px` }}>
      <ChipMark size={diameter} kind="seal" variant={isDark ? "outline" : "filled"} />
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-[1.5%] text-center">
        <svg width={checkPx} height={checkPx} viewBox="0 0 60 60" fill="none" aria-hidden="true" class="shrink-0">
          <path
            d="M14 30 L26 43 L48 17"
            fill="none"
            stroke={isDark ? "oklch(65% 0.15 155)" : "#fff"}
            stroke-width="8"
            stroke-linecap="square"
          />
        </svg>
        <span
          class="whitespace-nowrap font-extrabold leading-none text-white"
          style={{ fontSize: `${titlePx.toFixed(2)}px`, letterSpacing: "0.03em" }}
        >
          SWIFT SECURE
        </span>
        <span
          class:list={[
            // Uppercased in CSS rather than in the copy, so the browser applies
            // each locale's own casing rules (e.g. Turkish i → İ) and scripts
            // without case are left untouched.
            "whitespace-nowrap font-semibold uppercase leading-none",
            isDark ? "text-[oklch(70%_0.02_250)]" : "text-[oklch(88%_0.06_155)]",
          ]}
          style={{ fontSize: `${subPx.toFixed(2)}px`, letterSpacing: "0.14em" }}
        >
          {t.seal.certified}
        </span>
      </div>
    </div>
  )
}
