---
import { useTranslations, localePath } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="mt-auto border-t border-footer-line bg-footer px-5 py-10 text-footer-text sm:px-[clamp(20px,5vw,40px)]">
  <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-4">
    <div class="text-[15px] font-bold">Swift Secure</div>
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-footer-muted">
      <a href={localePath("/verify/", locale)} class="text-inherit hover:text-footer-text">{t.footer.verifySeal}</a>
      <a href={localePath("/apply/", locale)} class="text-inherit hover:text-footer-text">{t.footer.apply}</a>
      <a href={localePath("/faq/", locale)} class="text-inherit hover:text-footer-text">{t.footer.faq}</a>
      {/* Brand-asset reference. Reuses the badge page's own eyebrow so the
          label is already translated in all 19 locales. */}
      <a href={localePath("/badge/", locale)} class="text-inherit hover:text-footer-text">{t.badge.eyebrow}</a>
    </div>
    <div class="text-[13px] text-footer-faint">&copy; {new Date().getUTCFullYear()} Swift Secure</div>
  </div>
</footer>
