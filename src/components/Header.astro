---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ChipMark from "./ChipMark.astro";
import PreviewBanner from "./PreviewBanner.astro";
import { useTranslations, localePath } from "../i18n";

interface Props {
  locale: string;
  path: string;
  current?: "process" | "methodology" | "pricing" | "about" | "faq" | "casinos" | "verify";
}

const { locale, path, current } = Astro.props;
const t = useTranslations(locale);

/**
 * The bar carries four links, operators first. Four is a measured ceiling, not
 * a matter of taste: these labels exist in 20 languages and Spanish renders 44%
 * wider than English. With the previous seven, the header did not fit and the
 * whole page scrolled sideways in 18 of the 20 — Spanish by 406px at 1024px
 * wide, and still by 64px at 1366px. Four fits every language from 1100px.
 *
 * How it works, About and FAQ moved to the footer. The pages are unchanged and
 * still linked; only their place in the bar is gone. "How it works" is the one
 * that lost least by moving — every fact on it also appears on "What we check",
 * which additionally carries the audit boundaries and the revocation rules.
 *
 * Props["current"] deliberately still accepts the keys that are no longer here.
 * /about/, /faq/ and /how-it-works/ go on passing their own name, they simply
 * have nothing in the bar to highlight.
 */
const navItems: { key: NonNullable<Props["current"]>; href: string; label: string }[] = [
  { key: "pricing", href: "/pricing/", label: t.nav.pricing },
  { key: "methodology", href: "/methodology/", label: t.nav.methodology },
  { key: "casinos", href: "/casinos/", label: t.nav.casinos },
  { key: "verify", href: "/verify/", label: t.nav.verify },
];

const linkClass = (key: Props["current"]) =>
  current === key ? "font-semibold text-accent" : "text-nav-muted hover:text-nav-text";
---

<header class="sticky top-0 z-20 border-b border-nav-line bg-nav backdrop-blur-sm">
  {/* Inside the sticky header on purpose, so the warning cannot be scrolled away.
      It renders nothing at all on a production build. */}
  <PreviewBanner />
  <div class="flex items-center justify-between gap-3 px-5 py-3.5 sm:px-[clamp(20px,5vw,40px)]">
    <a href={localePath("/", locale)} class="flex shrink-0 items-center gap-2.5">
      <ChipMark size={32} kind="mark" />
      <span class="text-[17px] font-bold tracking-tight text-nav-text">Swift Secured</span>
    </a>

    <!-- Full nav, shown only from 1280px up. It used to appear at 1024px, which
         was wide enough for the English labels and for nothing else: at 1024px
         the header overflowed in 18 of 20 languages. The four-item bar fits
         everywhere from 1100px, so 1280px leaves ~180px of room for future
         wording. If this drops back to lg:, measure Spanish before shipping. -->
    <nav class="hidden items-center gap-4 text-sm font-medium text-nav-muted xl:flex" aria-label={t.nav.primaryLabel}>
      {
        navItems.map((item) => (
          <a
            href={localePath(item.href, locale)}
            class:list={["whitespace-nowrap", linkClass(item.key)]}
            aria-current={current === item.key ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={localePath("/apply/", locale)} class="btn-primary whitespace-nowrap px-3.5 py-2.5 font-semibold">
        {t.nav.apply}
      </a>
      <LanguageSwitcher locale={locale} path={path} />
    </nav>

    <!-- Apply stays in the always-visible bar on mobile; the language switcher
         moves into the panel below. There is only room for one of them beside
         the logo, and Apply is the action the page exists to drive. -->
    <div class="flex items-center gap-2 xl:hidden">
      <a href={localePath("/apply/", locale)} class="btn-primary whitespace-nowrap px-3.5 py-2 text-sm font-semibold">
        {t.nav.apply}
      </a>
      <button
        type="button"
        data-nav-toggle
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label={t.nav.openMenu}
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
        class="flex size-9 items-center justify-center rounded-chip border border-nav-line text-nav-text"
      >
        <span data-nav-icon-open class="flex">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
        <span data-nav-icon-close class="flex" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
      </button>
    </div>
  </div>

  <nav id="site-nav" data-nav-menu hidden class="border-t border-nav-line bg-nav px-5 pb-4 pt-2 xl:hidden" aria-label={t.nav.primaryLabel}>
    {
      navItems.map((item) => (
        <a
          href={localePath(item.href, locale)}
          class:list={["block border-b border-nav-line/60 py-3 text-[15px] font-medium", linkClass(item.key)]}
          aria-current={current === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <div class="mt-4">
      <LanguageSwitcher locale={locale} path={path} />
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
  const iconOpen = document.querySelector<HTMLElement>("[data-nav-icon-open]");
  const iconClose = document.querySelector<HTMLElement>("[data-nav-icon-close]");

  if (toggle && menu && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      iconOpen.hidden = open;
      iconClose.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute("aria-label", label);
    };

    toggle.addEventListener("click", () => setOpen(menu.hidden !== false));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.hidden === false) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Leaving the mobile breakpoint while the panel is open would otherwise
    // strand it visible behind the desktop nav on the next resize back down.
    // This number must stay equal to the xl: breakpoint used on the two navs
    // above. They are set in different languages — Tailwind and JavaScript —
    // so nothing links them but this comment.
    const wide = window.matchMedia("(min-width: 1280px)");
    wide.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
