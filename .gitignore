# build output
dist/
# generated types
.astro/
# wrangler's local state (deploy bookkeeping, dev cache)
.wrangler/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# crawler
crawler/node_modules/
crawler/reports/
.screenshots/

# scratch worktrees left behind by remote sessions
.claude/worktrees/

# proxy credentials — never commit
crawler/proxies.txt
.env.proxies

# partial sweep output — a limited run, never the canonical dataset
research/*.partial.json
research/*.partial.md

# python bytecode from the research scripts
__pycache__/
