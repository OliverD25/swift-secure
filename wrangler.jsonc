{
  // Without this file, `npx wrangler deploy` finds no config, decides it is
  // looking at an unconfigured Astro project, and runs `astro add cloudflare`
  // on the build machine — installing an SSR adapter, rewriting astro.config,
  // and building the whole site a second time. That happened on the first
  // deployment. It is wrong three ways: the adapter printed "Astro 7.1.3 is not
  // officially supported", the fix lived only on Cloudflare's builder so every
  // future build would redo it and could pick up a different adapter version,
  // and the site is 4,428 static files that need no server at all.
  //
  // With a config present, wrangler skips framework detection entirely and just
  // uploads what `npm run build` produced.
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker the Cloudflare project already created. It was named
  // before the Swift Secure → Swift Secured rename, so it is missing the "d"
  // that package.json has. Using the package name instead makes every build
  // print "Failed to match Worker name" and deploy under the CI's name anyway.
  "name": "swift-secure",

  "compatibility_date": "2026-08-04",

  // Attaching the domain here rather than clicking it in the dashboard, so the
  // arrangement is in the repository and survives whoever set it up. On deploy
  // wrangler creates the custom domain and the DNS record for each pattern; the
  // zone is already on Cloudflare's nameservers, which is what makes that
  // possible.
  //
  // Until this landed, every page told search engines its real address was
  // swiftsecured.com while that name had no address record at all — the site
  // was disowning itself in favour of somewhere that did not exist.
  //
  // www is listed too, because a visitor who types it should not meet a DNS
  // error. Both names serve the same pages, which would normally be a duplicate
  // problem; it is not one here because Astro builds every canonical URL from
  // the apex, so the www copy points at the apex as the original. A redirect
  // rule would be tidier still, but that cannot be expressed in this file and a
  // dashboard-only setting is exactly what this block exists to avoid.
  "routes": [
    { "pattern": "swiftsecured.com", "custom_domain": true },
    { "pattern": "www.swiftsecured.com", "custom_domain": true }
  ],

  // No "main": this is a static site, so the Worker is assets-only and no
  // JavaScript runs per request. Cloudflare serves the files directly.
  //
  // html_handling defaults to auto-trailing-slash, which maps /about to
  // dist/about/index.html — the layout Astro emits. There is no dist/404.html,
  // so not_found_handling stays at its default and Cloudflare returns its own
  // 404 rather than us pointing at a file that is not built.
  "assets": {
    "directory": "./dist"
  },

  // A second Worker, so staging has one fixed address instead of a new one per
  // push. Left at its default, Cloudflare runs `wrangler versions upload` on any
  // branch that is not main and hands back a URL with the version id in it —
  // safe, but useless for showing the same link to someone twice, and useless
  // for anything that has to be registered somewhere.
  //
  // Reached by setting the non-production branch deploy command to
  //   npx wrangler deploy --env staging
  // in the Cloudflare dashboard. That is the one part of this that cannot live
  // in the repository, and it is written down in .cloudflare-deploy.md.
  //
  // Nothing here can touch production. It is a different Worker name and a
  // different hostname, and the main branch never runs with --env.
  //
  // `assets` is repeated rather than relied on: wrangler inherits some top-level
  // keys into an environment and not others, and a staging Worker that silently
  // shipped with no files at all is not a failure anyone would notice quickly.
  // Verified with `wrangler deploy --env staging --dry-run`, which reports the
  // file count.
  //
  // Search engines are kept off it by branch, not by hostname: WORKERS_CI_BRANCH
  // is "staging" there, which src/lib/deploy.ts treats as unindexed, so every
  // page carries noindex and robots.txt serves Disallow. Confirmed by building
  // with that variable set — 0 of 4,428 pages came out indexable.
  "env": {
    "staging": {
      "name": "swift-secure-staging",
      "routes": [{ "pattern": "staging.swiftsecured.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist"
      }
    }
  }
}
